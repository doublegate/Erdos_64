  "spectral_moore_exclusions": {
    "moore_3_8_bipartite": {
      "theorem": "Theorem 2.4(c)",
      "hankel_det_h3_at_c6_0": "144 * n^2 * (n - 31*r) >= 0",
      "bipartite_r2_min_n": 62,
      "conclusion": "No bipartite cubic graph of girth g >= 8 with C_8(G) = 0 exists for n < 62; hence C_6(G) >= 1 across 50 <= n <= 60."
    },
    "moore_3_10_at_n62": {
      "theorem": "Theorem 2.6(b)",
      "order_n": 62,
      "r": 2,
      "stieltjes_lower_bound_5c10": 1488,
      "hausdorff_upper_bound_5c10": 1488,
      "integer_interval_C10": [298, 297],
      "conclusion": "5 * C_10(G) = 1488 has no integer solution ([298, 297] = empty); no (3,10)-Moore graph on n = 62 exists, so C_6(G) >= 1 for all bipartite C_4 = C_8 = 0 cubic graphs on 50 <= n <= 62."
    },
    "moore_3_14_at_n254": {
      "theorem": "Theorem 2.8(b)",
      "order_n_r1": 127,
      "order_n_r2": 254,
      "pinched_b14": 384,
      "tr_b14_r1": 48768,
      "tr_b14_r2": 97536,
      "mod_28_r1": 20,
      "mod_28_r2": 12,
      "conclusion": "det H_4(mu) = 13824 * n^3 * (n - 127*r) = 0 pinches b_14 = 384, forcing Tr(B^14) = 384 * 127 * r != 0 (mod 28), contradicting Tr(B^14) = 28 * C_14(G) and ruling out the (3,14)-Moore graph at n = 127 and n = 254."
    }
  },
